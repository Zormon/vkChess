[input_devices]

pointing/use_filter=true

[layer_names]

3d_physics/layer_1="Ground"
3d_physics/layer_2="Kastpinne"
3d_physics/layer_3="Kubb"
3d_physics/layer_4="Boundary"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
